BEGIN PROBLEMDATA

# This is used for nodal enrichment: MaxNumTerms = 1 (default)
# Also used to create exact solution based on MaxNumTerms = 1
EdgeElas2D 100 { NodeOrigin = 100000000, NodeXAxis = 100000001 }

# This is used for nodal enrichment Linear Branch: MaxNumTerms = 1 (default)
# Also used to create exact solution based on MaxNumTerms = 1
EdgeElasHO2D 101 { NodeOrigin = 100000000, NodeXAxis = 100000001 }

# This is used to create exact solution based on MaxNumTerms > 1
EdgeElas2D 102 { MaxNumTerms = 10, NodeOrigin = 100000000, NodeXAxis = 100000001 }

# Step Function
StepFunCyl2D 1 {NodeOrigin=100000000, NodeXAxis=100000001, Theta_0=0.0, Theta_1=180.0}

# Branch+Heavside enrichment pair
BranchStepPair 200 { BranchFnID = 100,  StepFnID = 1 }

# Branch+Heavside enrichment pair (Linear Branch)
BranchStepPair 201 { BranchFnID = 101,  StepFnID = 1 }


END

